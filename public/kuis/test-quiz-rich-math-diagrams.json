        "id": "q1",
        "type": "multiple-choice",
        "prompt": "Rumus kuadrat untuk persamaan berikut adalah:\n\n$$ ax^2 + bx + c = 0 $$",
        "choices": [
          {
            "id": "a",
            "text": "\\( x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a} \\)"
          },
          {
            "id": "b",
            "text": "\\( x = \\frac{b \\pm \\sqrt{b^2 + 4ac}}{2a} \\)"
          },
          {
            "id": "c",
            "text": "\\( x = \\frac{-b \\pm \\sqrt{a^2 - 4bc}}{2c} \\)"
          }
        ],
        "answer": "a",
        "explanation": "Rumus kuadrat memakai diskriminan \\(b^2 - 4ac\\): \\(x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}\\)."
      },
      {
        "id": "q2",
        "type": "multiple-choice",
        "prompt": "Segitiga \\(ABC\\) memiliki \\(AB = AC\\) dan \\(\\angle A = 40^\\circ\\). Berapa besar \\(\\angle C\\)?",
        "diagram": {
          "type": "triangle",
          "title": "Segitiga ABC dengan sudut A",
          "pointLabels": {
            "a": "A",
            "b": "B",
            "c": "C"
          },
          "angleLabel": "\\(40^\\circ\\)",
          "leftLabel": "\\(AB\\)",
          "rightLabel": "\\(AC\\)",
          "baseLabel": "\\(\\angle C = ?\\)",
          "questionLabel": "Cari \\(\\angle C\\)"
        },
        "choices": [
          { "id": "a", "text": "\\(50^\\circ\\)" },
          { "id": "b", "text": "\\(70^\\circ\\)" },
          { "id": "c", "text": "\\(80^\\circ\\)" }
        ],
        "answer": "b",
        "explanation": "Karena \\(AB = AC\\), sudut alas sama besar. Maka \\(\\angle B = \\angle C = \\frac{180^\\circ - 40^\\circ}{2} = 70^\\circ\\)."
      },
      {
        "id": "q3",
        "type": "multiple-choice",
        "prompt": "Sebuah kubus memiliki panjang rusuk \\(s = 4\\text{ cm}\\). Berapa volumenya?",
